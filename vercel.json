{
  "version": 2,
  "framework": "create-react-app",
  "buildCommand": "yarn --cwd frontend build",
  "outputDirectory": "frontend/build",
  "installCommand": "yarn --cwd frontend install --frozen-lockfile",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/transaksi",
      "destination": "/index.html"
    },
    {
      "source": "/nota",
      "destination": "/index.html"
    }
  ]
}
